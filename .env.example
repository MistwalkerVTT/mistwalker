# =============================================================================
# MistWalker 3.0 Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit your actual .env file to public source control (GitHub, etc.).
# =============================================================================

# [REQUIRED] Primary Google Gemini API key for AI DM chat, map generation, vision, and NPC lore
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# [OPTIONAL] Comma-separated backup Gemini API keys for quota failover & high-traffic resilience
# Example: GEMINI_FALLBACK_KEYS="key_backup_1,key_backup_2"
GEMINI_FALLBACK_KEYS=""

# [OPTIONAL] D&D Beyond CobaltSession authentication cookie token
# Allows real-time D&D Beyond campaign character sync, monster compendium sync, and live HP polling.
# Obtain from your browser's Developer Tools -> Application -> Cookies -> dndbeyond.com -> CobaltSession
DND_BEYOND_COBALT_SESSION=""

# [OPTIONAL] ElevenLabs API key for realistic audio narration / voice generation
# Obtain at: https://elevenlabs.io
ELEVENLABS_API_KEY=""

# [HOST-MANAGED] Server Port & Runtime Environment
# On Render / Railway / Cloud Run, PORT is automatically injected by the platform.
# Defaults to 3000 locally.
PORT=3000
NODE_ENV="production"
