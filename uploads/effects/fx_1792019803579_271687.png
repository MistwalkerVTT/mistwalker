<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
    <defs>
      <radialGradient id="burst" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
        <stop offset="20%" stop-color="#fca5a5" stop-opacity="0.95" />
        <stop offset="55%" stop-color="#ef4444" stop-opacity="0.65" />
        <stop offset="85%" stop-color="#ef4444" stop-opacity="0.2" />
        <stop offset="100%" stop-color="#000000" stop-opacity="0" />
      </radialGradient>
      <filter id="glow">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>
    <rect width="512" height="512" fill="#000000" />
    <circle cx="256" cy="256" r="230" fill="url(#burst)" />
    <circle cx="256" cy="256" r="170" fill="none" stroke="#fca5a5" stroke-width="2.5" stroke-dasharray="16, 8, 4, 8" opacity="0.8" filter="url(#glow)" />
    <circle cx="256" cy="256" r="140" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="8, 12" opacity="0.6" />
    <circle cx="256" cy="256" r="60" fill="#ffffff" opacity="0.8" filter="url(#glow)" />
    <circle cx="256" cy="110" r="4" fill="#fca5a5" opacity="0.9" />
    <circle cx="370" cy="190" r="3" fill="#ffffff" opacity="0.9" />
    <circle cx="340" cy="350" r="5" fill="#fca5a5" opacity="0.8" />
    <circle cx="160" cy="330" r="4" fill="#fca5a5" opacity="0.9" />
    <circle cx="130" cy="180" r="3" fill="#ffffff" opacity="0.8" />
  </svg>